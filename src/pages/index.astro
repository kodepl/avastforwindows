---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_CONFIG, LAYOUT_CONFIG } from '../pbn-config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

let featuredPost = null;
let regularPosts = posts;

if (posts.length > 0) {
  featuredPost = posts.find(p => p.data.featured) || posts[0];
  regularPosts = posts.filter(p => p.slug !== featuredPost?.slug);
}

const securityPosts = posts.filter(p => p.data.category === 'Security').slice(0, 3);
const windowsPosts = posts.filter(p => p.data.category === 'Windows').slice(0, 3);
---

<BaseLayout title={SITE_CONFIG.name} description={SITE_CONFIG.description} type="website" breadcrumbs={[]}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-emerald-900 via-slate-800 to-slate-900 border-b border-emerald-700/30 mb-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-sm font-mono mb-6">
          <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
          SYSTEM PROTECTION ACTIVE
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-tight">
          Secure Your
          <span class="text-emerald-400 block">Windows PC</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-2xl leading-relaxed">
          {SITE_CONFIG.description}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#articles" class="inline-flex items-center px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded transition-colors font-heading tracking-wide">
            Browse Guides
          </a>
          <a href="/blog" class="inline-flex items-center px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded transition-colors border border-slate-600">
            All Articles
          </a>
        </div>
        
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 mt-12 pt-8 border-t border-slate-700/50">
          <div>
            <div class="text-3xl font-heading font-bold text-emerald-400">{posts.length}+</div>
            <div class="text-sm text-slate-400 mt-1">Security Guides</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-bold text-cyan-400">100%</div>
            <div class="text-sm text-slate-400 mt-1">Free Resources</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-bold text-white">24/7</div>
            <div class="text-sm text-slate-400 mt-1">Protection</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2">
      <!-- Featured Post -->
      {featuredPost && (
        <section class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1 h-6 bg-emerald-500 rounded"></div>
            <h2 class="text-xl font-heading font-bold text-white">Featured Guide</h2>
          </div>
          <a href={`/blog/${featuredPost.slug}/`} class="group block">
            <article class="bg-slate-800/50 border border-emerald-700/30 rounded-lg overflow-hidden hover:border-emerald-600/50 transition-all">
              <div class="grid md:grid-cols-2 gap-0">
                <div class="aspect-video md:aspect-auto overflow-hidden">
                  <img 
                    src={featuredPost.data.coverImage} 
                    alt={featuredPost.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
                <div class="p-6 flex flex-col justify-center">
                  <span class="text-emerald-400 text-xs font-mono uppercase tracking-wider mb-2">{featuredPost.data.category}</span>
                  <h3 class="text-2xl font-heading font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
                    {featuredPost.data.title}
                  </h3>
                  <p class="text-slate-300 text-sm mb-4">{featuredPost.data.description}</p>
                  <span class="text-emerald-400 text-sm font-medium group-hover:text-emerald-300 transition-colors">Read Guide →</span>
                </div>
              </div>
            </article>
          </a>
        </section>
      )}

      <!-- Latest Articles -->
      <section id="articles">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-6 bg-cyan-500 rounded"></div>
          <h2 class="text-xl font-heading font-bold text-white">Latest Security Guides</h2>
        </div>
        <div class="space-y-6">
          {regularPosts.slice(0, 5).map(post => <PostCard post={post} variant="horizontal" />)}
        </div>
        <div class="mt-8 text-center">
          <a href="/blog" class="inline-flex items-center px-6 py-3 border border-emerald-700/50 text-emerald-400 hover:bg-emerald-900/30 rounded transition-colors">
            View All {posts.length} Articles
          </a>
        </div>
      </section>
    </div>

    <!-- Sidebar -->
    <aside class="space-y-8">
      <!-- Security Category -->
      <div class="bg-slate-800/50 border border-emerald-700/30 rounded-lg p-6">
        <h3 class="text-lg font-heading font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          Security
        </h3>
        <div class="space-y-3">
          {securityPosts.map(post => (
            <a href={`/blog/${post.slug}/`} class="group block">
              <h4 class="text-sm text-slate-300 group-hover:text-emerald-300 transition-colors line-clamp-2">{post.data.title}</h4>
              <span class="text-xs text-slate-500">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Windows Category -->
      <div class="bg-slate-800/50 border border-cyan-700/30 rounded-lg p-6">
        <h3 class="text-lg font-heading font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-cyan-500 rounded-full"></span>
          Windows
        </h3>
        <div class="space-y-3">
          {windowsPosts.map(post => (
            <a href={`/blog/${post.slug}/`} class="group block">
              <h4 class="text-sm text-slate-300 group-hover:text-cyan-300 transition-colors line-clamp-2">{post.data.title}</h4>
              <span class="text-xs text-slate-500">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Newsletter -->
      <div class="bg-gradient-to-br from-emerald-900/40 to-slate-800/50 border border-emerald-700/30 rounded-lg p-6">
        <h3 class="text-lg font-heading font-bold text-white mb-2">Security Alerts</h3>
        <p class="text-sm text-slate-400 mb-4">Get notified about new threats and protection guides.</p>
        <form class="space-y-3">
          <input 
            type="email" 
            placeholder="your@email.com" 
            class="w-full px-4 py-2 bg-slate-900 border border-emerald-700/30 rounded text-white text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
          <button type="submit" class="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded transition-colors">
            Subscribe
          </button>
        </form>
      </div>
    </aside>
  </div>
</BaseLayout>
